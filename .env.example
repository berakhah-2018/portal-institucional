# Google Cloud OAuth 2.0 Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side role assignments: comma-separated email=ROLE pairs
APP_AUTH_ROLE_MAPPINGS=admin@example.com=ADMIN
APP_FRONTEND_URL=http://localhost:5173

# Local PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portal
SPRING_DATASOURCE_USERNAME=portal
SPRING_DATASOURCE_PASSWORD=change-me
